{
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ParkingDb;Trusted_Connection=True;MultipleActiveResultSets=true"
    },
    //ConnectionStrings-מפתח ראשי שמרכז את כל חיבורי 
    //מסד הנתונים של הפרויקט
    //DefaultConnection-שם זיהוי פנימי עבור החיבור הזה
    //Server=(localdb)\\mssqllocaldb: מורה לאפליקציה להתחבר לשרת ה-SQL המקומי של Visual Studio (LocalDB).
    //Database=ParkingDb: קובע את שם מסד הנתונים שייווצר בשרת.
    //Trusted_Connection=True- מראה להתחבר באמצעות הרשאות המשתשמ
    //של מערכת ההפעלה
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
