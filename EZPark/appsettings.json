    //הערך עצמו לא נשמר כאן - הוא מגיע ממשתנה הסביבה ConnectionStrings__DefaultConnection
    //Database=ParkingDb: קובע את שם מסד הנתונים שייווצר בשרת.
    //של מערכת ההפעלה
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
