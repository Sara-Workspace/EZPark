<Project Sdk="Microsoft.NET.Sdk.Web">
	<!-- פרויקט Web: האתר וה-API -->

	<PropertyGroup>
		<!-- התחלת ההגדרות הכלליות -->
		<TargetFramework>net9.0</TargetFramework>
		<!-- רץ על .NET 9 -->
		<Nullable>enable</Nullable>
		<!-- מאפשר סימון ? למשתנה שיכול להיות null -->
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- usings בסיסיים נוספים אוטומטית -->
		<UserSecretsId>97238dc3-071f-4f18-8276-31b75b5dc1c8</UserSecretsId>
		<!-- מזהה לשמירת סודות (נוצר אוטומטית) -->
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<!-- הגדרת Docker (נוצר אוטומטית) -->
	</PropertyGroup>
	<!-- סוף ההגדרות הכלליות -->

	<ItemGroup>
		<!-- רשימת ספריות חיצוניות -->
		<PackageReference Include="AutoMapper" Version="16.2.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4" />
		<!-- תיעוד ה-API -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
			<!-- כלים למיגרציות -->
			<PrivateAssets>all</PrivateAssets>
			<!-- הכלי לא עובר לפרויקטים אחרים -->
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<!-- אילו חלקים מהכלי לכלול -->
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<!-- תמיכה ב-Docker -->
	</ItemGroup>
	<!-- סוף רשימת הספריות -->

	<ItemGroup>
		<!-- רשימת פרויקטים שהאתר משתמש בהם -->
		<ProjectReference Include="..\DAL\DAL.csproj" />
		<!-- חיבור ל-DAL: בשביל ה-DbContext -->
		<ProjectReference Include="..\BLL\BLL.csproj" />
		<ProjectReference Include="..\DTO\DTO.csproj" />
		<!-- חדש: חיבור ל-BLL, בשביל ה-Repositories וה-Mapper -->
	</ItemGroup>
	<!-- סוף רשימת הפרויקטים -->

</Project>
<!-- סוף הגדרות הפרויקט -->